{
  "name": "roundtable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "backend": "node scripts/python.mjs -m backend.app.server --mode sim",
    "backend:live": "node scripts/python.mjs -m backend.app.server --mode live",
    "backend:replay": "node scripts/python.mjs -m backend.app.server --mode replay",
    "fake-session": "node scripts/python.mjs -m backend.app.fake_session --output sessions/fake",
    "start": "npm run build && node scripts/python.mjs -m backend.app.server --mode sim",
    "test": "vitest run && node scripts/python.mjs -m pytest -q",
    "typecheck": "tsc --noEmit",
    "vision:check": "node scripts/python.mjs scripts/check_vision_assets.py",
    "live": "npm run build && node scripts/python.mjs scripts/live.py",
    "live:dev": "node scripts/python.mjs scripts/live.py",
    "bonsai": "node scripts/python.mjs -m mlx_vlm.server --model models/bonsai2-2b-mlx --host 127.0.0.1 --port 8080",
    "setup:models": "node scripts/python.mjs scripts/setup_models.py"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vitest": "^4.0.15"
  }
}

# Copy to .env (never commit .env)
# Runtime key for Argmax Pro features (ax_..., 34 chars)
ARGMAX_API_KEY=
# Secret token for the Pro SDK package registry (axst_...), only needed to build the Pro helper
ARGMAX_SECRET_API_TOKEN=
# Whisper model for live streaming with the open-source CLI
ROUNDTABLE_WHISPER_MODEL=base
